# --- Utilisé par l'app React (préfixe VITE_ obligatoire pour Vite) ---
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# --- Utilisé uniquement par les scripts locaux (scripts/seed.mjs, scripts/generate-qrcodes.mjs) ---
# Clé "service_role" (Project Settings > API dans Supabase). NE JAMAIS mettre cette clé dans le code
# de l'app React ni la déployer publiquement : elle donne un accès total à la base.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# URL finale du site une fois déployé (Netlify, etc.) : utilisée pour générer les QR codes.
# Laisser en localhost pour tester avant le déploiement.
SITE_URL=http://localhost:3000

# --- Utilisé uniquement par scripts/export-to-drive.mjs (export après l'événement) ---
# Chemin vers le fichier JSON de clé du compte de service Google (voir README).
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./service-account-key.json
# ID du dossier Google Drive (dans l'URL du dossier, après /folders/), partagé
# en "Éditeur" avec l'adresse e-mail du compte de service.
GOOGLE_DRIVE_FOLDER_ID=
